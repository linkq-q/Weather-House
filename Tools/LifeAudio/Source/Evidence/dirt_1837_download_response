<script>
    function trackClicPub(label) {
        if (typeof gtag === 'function') {
            gtag('event', 'clic_pub_download', {
                'event_category': 'conversion',
                'event_label':    label || ''
            });
        }
    }

        // Délai d'attente : 5s pour les visiteurs anonymes, 0s pour les comptes connectés.
    // En mode WebView (Instagram, etc.), l'auto-submit est désactivé : l'utilisateur clique le bouton.
    (function() {
        var formId = 'dl-form';
        var delaiMs = 5 * 1000;
        var numEl   = document.getElementById('dl-countdown-num');

        // Compte à rebours visuel (uniquement si l'élément existe, donc visiteur anonyme)
        if (numEl) {
            var restant = parseInt(numEl.textContent, 10) || 0;
            var tick = setInterval(function() {
                restant -= 1;
                if (restant <= 0) {
                    numEl.textContent = '0';
                    clearInterval(tick);
                } else {
                    numEl.textContent = String(restant);
                }
            }, 1000);
        }

        function lancer() {
            var f = document.getElementById(formId);
            if (f) f.submit();
        }

        if (delaiMs <= 0) {
            lancer();
        } else {
            setTimeout(lancer, delaiMs);
        }

        // 2 secondes après le déclenchement automatique : fondu enchaîné entre le compte à rebours et le lien manuel.
        var delaiLienManuelMs = (delaiMs > 0 ? delaiMs : 5000) + 2000;
        setTimeout(function() {
            var countdown = document.getElementById('dl-countdown');
            var wrap = document.getElementById('lien-manuel-wrap');
            if (!countdown || !wrap) return;
            countdown.style.opacity = '0';
            setTimeout(function() {
                countdown.innerHTML = wrap.innerHTML;
                wrap.parentNode.removeChild(wrap);
                countdown.style.opacity = '1';
            }, 500);
        }, delaiLienManuelMs);
    })();
    </script>

